# API
API_PORT=4000

# Database: leave unset for embedded PGlite (dev, stored in .data/pglite),
# or set a postgres:// URL for a real Postgres instance (prod).
# DATABASE_URL=postgres://mystic:mystic@localhost:5432/mystic

# Meilisearch
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=mystic-dev-master-key

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: enables LLM concept labeling in the ontology pipeline (Phase 2)
# ANTHROPIC_API_KEY=
